//@version=6
strategy(title='PYRO ALGO STRATEGY', shorttitle='PYROALGO-AI-BACKTEST', overlay=true, max_boxes_count=500, max_lines_count=500, initial_capital=10000)

//====================================================
// TABLE VISIBILITY
//====================================================
showPriceTable = input.bool(true, 'Show Price Dashboard', group='Table Visibility')
showBankTable = input.bool(true, 'Show Bank Dashboard', group='Table Visibility')

//====================================================
// BUY AND SELL - STOCHASTIC
//====================================================
choice = input.string('stoch', title='', options=['stoch'], inline='0')
i_K = input.int(14, title='', minval=1, group='    K       D      Smooth', inline='1')
i_D = input.int(3, title='', minval=1, group='    K       D      Smooth', inline='1')
i_smoothK = input.int(3, title='', minval=1, group='    K       D      Smooth', inline='1')
i_limLen = input.int(20, title='', minval=1, group='limits (length) - Overbought - Oversold', inline='2')
i_Overbought = input.int(80, title='', minval=1, group='limits (length) - Overbought - Oversold', inline='2')
i_Oversold = input.int(20, title='', minval=1, group='limits (length) - Overbought - Oversold', inline='2')

stochHighestK = ta.highest(high, i_K)
stochLowestK = ta.lowest(low, i_K)
limitHighest = ta.highest(high, i_limLen)
limitLowest = ta.lowest(low, i_limLen)

f_limit(_limit, _limH, _limL) => _limL + _limit / 100 * (_limH - _limL)

f_stoch(_smoothK, _D, _limH, _limL, _stochH, _stochL) =>
    _stochRange = _stochH - _stochL
    _stoch = _stochRange != 0 ? _limL + (_limH - _limL) * (close - _stochL) / _stochRange : _limL
    _Ko = ta.sma(_stoch, _smoothK)
    _Do = ta.sma(_Ko, _D)
    [_Ko, _Do]

[K, D] = f_stoch(i_smoothK, i_D, limitHighest, limitLowest, stochHighestK, stochLowestK)

stochCrossUp = ta.crossover(K, D)
stochCrossDown = ta.crossunder(K, D)

//====================================================
// SUPERTREND - DISPLAY
//====================================================
atrPeriod = input.int(50, 'ATR Length', group='SuperTrend Setting')
factor = input.float(3.0, 'Factor', step=0.1, group='SuperTrend Setting')
[supertrendDisplay, directionDisplay] = ta.supertrend(factor, atrPeriod)

//====================================================
// INDICATORS LOGIC
//====================================================
len = input.int(10, 'SuperTrend Length 2')
mult = input.int(2, 'SuperTrend Multiplier 2')
[superTrend, dir] = ta.supertrend(mult, len)

buySignal = dir == -1 and dir[1] == 1
sellSignal = dir == 1 and dir[1] == -1

//====================================================
// BACKTEST STRATEGY ENTRY / EXIT
//====================================================
useStoch = input.bool(true, 'Use Stochastic for Entry', group='Strategy Options')
useSuperTrend = input.bool(true, 'Use SuperTrend for Entry', group='Strategy Options')

longCondition = (not useStoch or stochCrossUp) and (not useSuperTrend or dir == -1)
shortCondition = (not useStoch or stochCrossDown) and (not useSuperTrend or dir == 1)

if (longCondition)
    strategy.entry("Long", strategy.long)

if (shortCondition)
    strategy.entry("Short", strategy.short)

//====================================================
// FIBONACCI WAVE - 4 LEVELS
//====================================================
automaticTimeframe = input.bool(true, title='Automatic Timeframe')
userTimeframe = input.int(15, minval=1, title='Timeframe')
fibratio1 = input.float(1.618, title='RES/SUP 1')
timeframeInUse = automaticTimeframe ? timeframe.multiplier : userTimeframe
smaFib = ta.sma(close, timeframeInUse)
avgFib = ta.atr(timeframeInUse)
r1 = avgFib * fibratio1
High1 = smaFib + r1
Low1 = smaFib - r1
H1 = plot(High1, color=color.rgb(211, 208, 24), title='Max 1')
L1 = plot(Low1, color=color.rgb(47, 243, 29, 6), title='Min 1')

// Note: The rest of the dashboards and multi-timeframe logic were truncated in the original code,
// so they have been omitted or simplified here to ensure the strategy runs correctly.
